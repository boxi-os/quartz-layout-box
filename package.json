{
  "name": "quartz-layout-box",
  "version": "0.4.1",
  "description": "Quartz v5 layout component that renders an HTML or Markdown snippet (file or inline) anywhere in the page layout.",
  "type": "module",
  "license": "MIT",
  "author": "boxi-os",
  "homepage": "https://github.com/boxi-os/quartz-layout-box",
  "repository": {
    "type": "git",
    "url": "https://github.com/boxi-os/quartz-layout-box"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "quartz-component",
    "layout",
    "sidebar",
    "snippet"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "vfile": "^6.0.3"
  },
  "dependencies": {
    "@quartz-community/types": "^0.2.1",
    "@quartz-community/utils": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "preact": "^10.28.2",
    "prettier": "^3.6.2",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "quartz": {
    "name": "quartz-layout-box",
    "displayName": "Layout Box",
    "description": "Renders an HTML or Markdown snippet (file or inline) as a layout component.",
    "category": [
      "component"
    ],
    "version": "0.4.1",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultEnabled": true,
    "defaultOptions": {
      "file": "snippet.html",
      "dir": "quartz/static/snippets",
      "placeholders": true,
      "collapsible": false,
      "collapsed": false,
      "frontmatterKey": "layoutBox"
    },
    "configSchema": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/file"
        },
        "dir": {
          "type": "string",
          "description": "Directory holding snippet files, relative to the site root. Paths leading out of it are refused.",
          "x-quartz-order": 30,
          "x-quartz-advanced": true,
          "x-quartz-group": "Content",
          "x-quartz-l10n": {
            "de": {
              "description": "Ordner für Snippet-Dateien, relativ zur Wurzel der Quartz-Site. Pfade, die aus diesem Ordner hinausführen, werden abgelehnt.",
              "group": "Inhalt"
            }
          }
        },
        "html": {
          "$ref": "#/$defs/html"
        },
        "placeholders": {
          "$ref": "#/$defs/placeholders"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "collapsible": {
          "$ref": "#/$defs/collapsible"
        },
        "collapsed": {
          "$ref": "#/$defs/collapsed"
        },
        "className": {
          "$ref": "#/$defs/className"
        },
        "frontmatterKey": {
          "type": "string",
          "description": "Frontmatter key a single page uses to hide or replace the box.",
          "x-quartz-order": 90,
          "x-quartz-advanced": true,
          "x-quartz-group": "Per page and language",
          "x-quartz-l10n": {
            "de": {
              "description": "Name des Frontmatter-Feldes, über das eine einzelne Seite die Box ausblenden oder tauschen kann.",
              "group": "Je Seite und Sprache"
            }
          }
        },
        "byLang": {
          "type": "object",
          "description": "Per-language overrides, keyed by language code or locale (`en`, `en-US`; case-insensitive). The entry matching the page language is merged over the options above.",
          "additionalProperties": {
            "$ref": "#/$defs/langOptions"
          },
          "x-quartz-keys": "languages",
          "x-quartz-order": 100,
          "x-quartz-group": "Per page and language",
          "x-quartz-l10n": {
            "de": {
              "description": "Abweichende Optionen je Sprache, Schlüssel ist der Sprachcode oder die Locale der Seite (`en`, `en-US`). Der passende Eintrag wird über die Optionen oben gelegt.",
              "group": "Je Seite und Sprache"
            }
          }
        }
      },
      "additionalProperties": false,
      "$defs": {
        "file": {
          "type": "string",
          "description": "Snippet file inside `dir`. Files ending in `.md` are rendered as Markdown. Ignored when `html` is set.",
          "x-quartz-widget": "snippetFile",
          "x-quartz-dir-option": "dir",
          "x-quartz-order": 10,
          "x-quartz-group": "Content",
          "x-quartz-l10n": {
            "de": {
              "description": "Dateiname des Snippets in `dir`. Dateien mit der Endung `.md` werden als Markdown gerendert. Wird ignoriert, wenn `html` gesetzt ist.",
              "group": "Inhalt"
            }
          }
        },
        "html": {
          "type": "string",
          "description": "Inline HTML rendered instead of a snippet file. Takes precedence over `file`.",
          "x-quartz-widget": "html",
          "x-quartz-order": 20,
          "x-quartz-group": "Content",
          "x-quartz-l10n": {
            "de": {
              "description": "HTML direkt in der Konfiguration. Hat Vorrang vor `file`.",
              "group": "Inhalt"
            }
          }
        },
        "placeholders": {
          "type": "boolean",
          "description": "Replace `{{placeholder}}` tokens in the snippet.",
          "x-quartz-order": 40,
          "x-quartz-group": "Content",
          "x-quartz-l10n": {
            "de": {
              "description": "Platzhalter der Form `{{name}}` im Snippet ersetzen. Ausgeschaltet bleibt der Text unverändert.",
              "group": "Inhalt"
            }
          }
        },
        "title": {
          "type": "string",
          "description": "Heading rendered above the content (an `h3`, like other sidebar components). May contain placeholders.",
          "x-quartz-order": 50,
          "x-quartz-group": "Form",
          "x-quartz-l10n": {
            "de": {
              "description": "Überschrift über dem Inhalt, gerendert als `h3` wie bei anderen Seitenleisten-Komponenten. Darf Platzhalter enthalten.",
              "group": "Form"
            }
          }
        },
        "collapsible": {
          "type": "boolean",
          "description": "Wrap the box in `<details>`/`<summary>` using `title` as the summary. Needs a `title`.",
          "x-quartz-order": 60,
          "x-quartz-group": "Form",
          "x-quartz-l10n": {
            "de": {
              "description": "Box als aufklappbares Element rendern; `title` wird zur Zeile, auf die man klickt. Braucht einen `title`.",
              "group": "Form"
            }
          }
        },
        "collapsed": {
          "type": "boolean",
          "description": "Start collapsed.",
          "x-quartz-when": {
            "collapsible": true
          },
          "x-quartz-order": 70,
          "x-quartz-group": "Form",
          "x-quartz-l10n": {
            "de": {
              "description": "Box beim Laden zugeklappt anzeigen.",
              "group": "Form"
            }
          }
        },
        "className": {
          "type": "string",
          "description": "Extra CSS class(es) added next to the fixed `layout-box` class, to style several instances apart.",
          "x-quartz-order": 80,
          "x-quartz-advanced": true,
          "x-quartz-group": "Form",
          "x-quartz-l10n": {
            "de": {
              "description": "Zusätzliche CSS-Klasse(n) neben der festen Klasse `layout-box`, um mehrere Instanzen getrennt zu gestalten.",
              "group": "Form"
            }
          }
        },
        "langOptions": {
          "type": "object",
          "description": "Options that may differ per language.",
          "properties": {
            "file": {
              "$ref": "#/$defs/file"
            },
            "html": {
              "$ref": "#/$defs/html"
            },
            "placeholders": {
              "$ref": "#/$defs/placeholders"
            },
            "title": {
              "$ref": "#/$defs/title"
            },
            "collapsible": {
              "$ref": "#/$defs/collapsible"
            },
            "collapsed": {
              "$ref": "#/$defs/collapsed"
            },
            "className": {
              "$ref": "#/$defs/className"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "components": {
      "LayoutBox": {
        "displayName": "Layout Box",
        "defaultPosition": "left",
        "defaultPriority": 15
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
